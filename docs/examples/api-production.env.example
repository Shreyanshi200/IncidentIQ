# Use an immutable image produced after a successful merge to main. Never use a development tag here.
INCIDENTIQ_API_IMAGE=ghcr.io/<github-owner-lowercase>/incidentiq-api:sha-<commit-sha>

# Use a dedicated PostgreSQL database user with only the permissions IncidentIQ needs.
# Copy the exact TLS connection string recommended by your managed PostgreSQL provider.
DATABASE_URL=postgresql://incidentiq:<replace-password>@<database-host>:5432/incidentiq?sslmode=require

# The container is exposed only to the local reverse proxy by the compose file.
PORT=3000
