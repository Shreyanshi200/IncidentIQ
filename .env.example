DATABASE_URL=postgresql://incidentiq:incidentiq@localhost:5432/incidentiq

# Positive minute values. These defaults group nearby evidence and include preceding context.
INCIDENTIQ_INCIDENT_GAP_MINUTES=10
INCIDENTIQ_CONTEXT_LOOKBACK_MINUTES=10

# Optional locally. This server-only cookie-signing secret is not an iiq_ API key.
# Set a stable random value of at least 32 bytes to keep dashboard sessions valid across API restarts.
# INCIDENTIQ_SESSION_SECRET=paste-output-from-openssl-rand-base64-48
