DATABASE_URL=postgresql://incidentiq:incidentiq@localhost:5432/incidentiq

# Positive minute values. These defaults group nearby evidence and include preceding context.
INCIDENTIQ_INCIDENT_GAP_MINUTES=10
INCIDENTIQ_CONTEXT_LOOKBACK_MINUTES=10

# Optional locally. This server-only cookie-signing secret is not an iiq_ API key.
# Set a stable random value of at least 32 bytes to keep dashboard sessions valid across API restarts.
# INCIDENTIQ_SESSION_SECRET=paste-output-from-openssl-rand-base64-48
# INCIDENTIQ_SESSION_ATTEMPTS_PER_MINUTE=20
# INCIDENTIQ_MAX_BODY_KB=256

# Optional evidence-bounded AI explanations. Both values are required to enable the dashboard action.
# Keep the API key on the API server; never expose it in VITE_ variables or producer configuration.
# OPENAI_API_KEY=replace-with-your-openai-api-key
# INCIDENTIQ_AI_MODEL=replace-with-a-structured-output-capable-model
# INCIDENTIQ_AI_TIMEOUT_SECONDS=60
# INCIDENTIQ_AI_MAX_OUTPUT_TOKENS=8000
# INCIDENTIQ_AI_MAX_INPUT_KB=512
# INCIDENTIQ_AI_REQUESTS_PER_HOUR=10
# INCIDENTIQ_AI_MAX_TIMELINE_EVENTS=100
# INCIDENTIQ_AI_REASONING_EFFORT=low
